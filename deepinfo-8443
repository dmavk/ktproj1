map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # 기존: listen 8443 http;
    listen 8443 ssl http2;         # <-- SSL 모드로 열기
    server_name www.deepinfo.kr deepinfo.kr;

    ssl_certificate     /home/ykk/PycharmProjects/PythonProject/ssl/fullchain.pem;
    ssl_certificate_key /home/ykk/PycharmProjects/PythonProject/ssl/privkey.pem;

    # Dash 프록시
    location / {
        proxy_pass https://127.0.0.1:18443/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Mission Planner
location /mp/ {
    # upstream은 Xpra(HTTPS)
    proxy_pass https://127.0.0.1:10000/;
    proxy_http_version 1.1;

    # WS
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # 원본 전달
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # (중요1) Location 헤더에 절대 URL이 오면 /mp/ 로 재작성
    proxy_redirect https://127.0.0.1:10000/ /mp/;
    proxy_redirect http://127.0.0.1:10000/  /mp/;

    # (중요2) HTML/JS 안에 박혀있는 절대 URL도 /mp/로 바꿔줌
    sub_filter_once off;
    sub_filter_types text/html application/javascript text/css;
    sub_filter "https://127.0.0.1:10000/" "/mp/";
    sub_filter "http://127.0.0.1:10000/"  "/mp/";
    # (필요 시) wss 주소도 재작성
    sub_filter "wss://127.0.0.1:10000/" "wss://$host:$server_port/mp/";
    sub_filter "ws://127.0.0.1:10000/"  "wss://$host:$server_port/mp/";

    # (필요시) iframe 차단 해제
    proxy_hide_header X-Frame-Options;
    # proxy_hide_header Content-Security-Policy;
}


    # QGroundControl
    location /qgc/ {
        proxy_pass https://127.0.0.1:10100/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Frame-Options;
    }
}


